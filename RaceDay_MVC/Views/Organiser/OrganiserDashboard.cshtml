@model List<RaceDay_MVC.Models.EventDto>
@{ ViewData["Title"] = "Organiser overview"; }
<div class="dashboard-header"><div><p class="eyebrow">ORGANISER WORKSPACE</p><h1>Your events. <span>Your community.</span></h1><p>Welcome, @User.Identity?.Name. Manage your events, categories and race results.</p></div><a asp-action="CreateEvent" class="pill-button">Create event ↗</a></div><section class="dashboard-container"><div class="dashboard-stats"><div class="stat-card"><div class="stat-info"><h2>@Model.Count</h2><p>Your events</p></div></div><div class="stat-card"><div class="stat-info"><h2>@Model.Count(e=>e.EventDate >= DateTime.Now)</h2><p>Upcoming events</p></div></div><div class="stat-card"><div class="stat-info"><h2>@Model.Sum(e=>e.Categories.Count)</h2><p>Race categories</p></div></div></div><h2 class="section-title">Your event collection</h2>@if(!Model.Any()) { <div class="empty-state"><h2>Your first start line awaits.</h2><p>Create an event to get started.</p></div> }<div class="live-event-grid">@foreach(var ev in Model.OrderByDescending(e=>e.EventDate)) { <article class="live-event-card"><partial name="_EventBanner" model="ev" /><div class="event-card-top"><span>@ev.Categories.Count CATEGORIES</span><span>@ev.EventDate.ToString("dd MMM yyyy")</span></div><h2>@ev.Name</h2><p>@ev.Description</p><div class="card-actions"><a asp-action="Banner" asp-route-id="@ev.EventId">Update banner →</a><a asp-action="Categories" asp-route-id="@ev.EventId">Categories →</a><a asp-action="Enrolments" asp-route-id="@ev.EventId">Enrolments →</a><a asp-action="Results" asp-route-id="@ev.EventId">Results →</a></div></article> }</div></section>
