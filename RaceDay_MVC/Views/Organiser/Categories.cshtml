@model RaceDay_MVC.Models.AddCategoryModel
@{ ViewData["Title"] = "Event categories"; }
<div class="dashboard-header"><div><p class="eyebrow">EVENT CATEGORIES</p><h1>@ViewBag.EventName</h1></div><a asp-action="OrganiserDashboard">Back to overview →</a></div><section class="dashboard-container"><div class="editor-card"><h2>Add a race category</h2><form asp-action="Categories" asp-route-id="@ViewBag.EventId" method="post"><div asp-validation-summary="All"></div><div class="auth-input-group"><label asp-for="Name">Category name</label><input asp-for="Name" maxlength="100" placeholder="e.g. 10 km Open" required /></div><div class="auth-input-group"><label asp-for="CategoryType">Category type</label><input asp-for="CategoryType" maxlength="20" placeholder="e.g. Running" required /></div><button class="pill-button" type="submit">Add category ↗</button></form></div><h2>Existing categories</h2><div class="category-chips">@foreach(RaceDay_MVC.Models.CategoryDto c in ViewBag.Categories) { <span>@c.Name · @c.CategoryType</span> }</div></section>
