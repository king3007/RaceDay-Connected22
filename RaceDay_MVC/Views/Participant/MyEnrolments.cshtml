@model List<RaceDay_MVC.Models.EnrolmentDto>
@{ ViewData["Title"] = "My enrolments"; }
<div class="dashboard-header"><div><p class="eyebrow">YOUR START LINES</p><h1>My enrolments.</h1></div><a asp-action="BrowseEvents" class="pill-button">Browse events ↗</a></div><section class="dashboard-container"><div class="data-table"><table><thead><tr><th>Entry</th><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model) { <tr><td>#@e.UniqueId</td><td>@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy HH:mm")</td><td>@e.CategoryName</td><td>@e.Status</td></tr> }</tbody></table>@if(!Model.Any()) { <p class="empty-state">You haven't enrolled in an event yet.</p> }</div></section>
