@{ ViewData["Title"] = "Race results"; }
<section class="results-hero"><p class="section-label">CELEBRATE YOUR FINISH</p><h1>Every finish counts.</h1><p>Results are available through your account.</p></section><section class="rd-section"><h2>View your race results.</h2><p>Participants can see their personal results. Organisers can view and capture results for their own events.</p>@if(User.IsInRole("Participant")) { <a asp-controller="Participant" asp-action="MyResults" class="pill-button">My results ↗</a> } else if(User.IsInRole("Organiser")) { <a asp-controller="Organiser" asp-action="OrganiserDashboard" class="pill-button">Manage event results ↗</a> } else { <a asp-action="Login" class="pill-button">Log in to view results ↗</a> }</section>
