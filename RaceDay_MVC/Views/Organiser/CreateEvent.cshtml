@model RaceDay_MVC.Models.CreateEventViewModel
@{ ViewData["Title"] = "Create event"; }
<section class="dashboard-page"><div class="dashboard-header"><div><p class="eyebrow">ORGANISER WORKSPACE</p><h1>Create an event.</h1><p>Add the event details supported by your RaceDay API.</p></div><a asp-action="OrganiserDashboard" class="text-link">Back to overview →</a></div><div class="dashboard-container"><div class="editor-card"><form asp-action="CreateEvent" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="validation-summary"></div><div class="auth-input-group"><label asp-for="Name">Event name</label><input asp-for="Name" required maxlength="200" /></div><div class="auth-input-group"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea></div><div class="auth-input-group"><label asp-for="EventDate">Event date and time</label><input asp-for="EventDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required /></div><div class="auth-input-group upload-panel"><label asp-for="BannerImage">Event banner (optional)</label><input asp-for="BannerImage" type="file" accept=".jpg,.jpeg,.png,.webp" data-image-input data-preview-target="banner-preview" /><span asp-validation-for="BannerImage" class="validation-summary"></span><p class="field-note">JPG, PNG or WebP · Up to 5 MB. A wide landscape image works best.</p><img id="banner-preview" class="upload-preview banner-preview" alt="Selected event banner preview" hidden /><p class="upload-feedback" aria-live="polite"></p></div><p class="field-note">After creating your event, add its race categories from the overview.</p><button class="pill-button" type="submit">Create event ↗</button></form></div></div></section>
