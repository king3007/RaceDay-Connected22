@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var dashboard = controller == "Organiser" || controller == "Participant" || controller == "Account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | RaceDay</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/redesign.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
</head>
<body class="@(dashboard ? "workspace" : "public-site")">
    <a class="skip-link" href="#main-content">Skip to content</a>
    @if (dashboard) { <partial name="_dashnavs" /> }
    else { <partial name="_navigation" /> }
    <main id="main-content" tabindex="-1">
    @if (TempData["Success"] is string success) { <div class="notice notice-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="notice notice-error" role="alert">@error</div> }
    @RenderBody()</main>
    <footer class="site-footer"><a asp-controller="Home" asp-action="Index" class="footer-brand">RaceDay<span>↗</span></a><p>Find your pace. Find your people.</p><a asp-controller="Home" asp-action="ContactUs">Get in touch →</a></footer>
    <script src="~/js/redesign.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
