@{
    ViewData["Title"] = "About Us";
}





<section class="about-content">

    <!-- About Hero Section -->
    <div class="about-hero">

        <p class="section-label">GET TO KNOW US</p>

        <h1>About <span>RaceDay</span></h1>

        <p>
            Connecting South Africa's sporting community through
            better event management and unforgettable race experiences.
        </p>

    </div>

    <!-- Our Story -->
    <div class="about-story">

        <div class="story-text">

            <p class="section-label">OUR STORY</p>

            <h2>Making Every Race Experience Better</h2>

            <p>
                South Africa has a strong sporting culture, with thousands
                of people taking part in road running, walking and cycling
                events throughout the country.
            </p>

            <p>
                However, managing these events can be challenging when
                registrations, participant information and race results
                are handled through different systems.
            </p>

            <p>
                RaceDay was created to provide a centralised platform
                where event organisers can manage their sporting events
                and participants can easily discover, enter and keep track
                of their race experiences.
            </p>

        </div>

        <div class="story-image">
            <img src="~/images/about-raceday.png"
                 alt="Participants taking part in a road running event" />
        </div>

    </div>

    <!-- Mission and Vision -->
    <div class="mission-vision">

        <div class="about-card">

            <h2>Our Mission</h2>

            <p>
                To simplify sporting event management by providing a
                reliable and accessible platform that connects event
                organisers and participants across South Africa.
            </p>

        </div>

        <div class="about-card">

            <h2>Our Vision</h2>

            <p>
                To become a trusted event management platform that
                supports the growth of road running, walking and cycling
                communities throughout South Africa.
            </p>

        </div>

    </div>

    <!-- Why Choose RaceDay -->
    <div class="why-raceday">

        <p class="section-label">WHY RACEDAY?</p>

        <h2>What Makes Us Different?</h2>

        <div class="why-container">

            <div class="why-card">
                <h3>Convenience</h3>
                <p>
                    Find and register for sporting events through
                    one convenient online platform.
                </p>
            </div>

            <div class="why-card">
                <h3>Easy Management</h3>
                <p>
                    Give event organisers tools to manage events,
                    categories and participant enrolments.
                </p>
            </div>

            <div class="why-card">
                <h3>Performance Tracking</h3>
                <p>
                    Help participants view their race results
                    and personal performance history.
                </p>
            </div>

        </div>

    </div>

    <!-- Closing Section -->
    <div class="about-closing">

        <h2>Be Part of the RaceDay Community</h2>

        <p>
            Whether you are organising an event or preparing for your
            next race, RaceDay is here to make your experience easier.
        </p>

        <a href="@Url.Action("Register", "Home")" class="primary-btn">
            Join RaceDay
        </a>

    </div>

</section>
