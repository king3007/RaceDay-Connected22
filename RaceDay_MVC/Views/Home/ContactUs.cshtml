@{
    ViewData["Title"] = "Contact Us";
}



<!-- Navigation -->



<div class="contact-page">

    <!-- Hero Section -->
    <section class="contact-hero">
        <p class="section-label">WE ARE HERE TO HELP</p>

        <h1>Contact <span>Us</span></h1>

        <p>
            Have a question about an event, registration or your race results?
            Get in touch with the RaceDay team. We would love to hear from you!
        </p>
    </section>


    <!-- Contact Section -->
    <section class="contact-section">

        <!-- Contact Information -->
        <div class="contact-info">

            <h2>Get In Touch</h2>

            <p>
                Our team is ready to assist you with your questions
                and enquiries.
            </p>

            <div class="contact-item">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                    <h3>Our Location</h3>
                    <p>Johannesburg, South Africa</p>
                </div>
            </div>

            <div class="contact-item">
                <i class="fa-solid fa-envelope"></i>
                <div>
                    <h3>Email Us</h3>
                    <p>support@raceday.co.za</p>
                </div>
            </div>

            <div class="contact-item">
                <i class="fa-solid fa-phone"></i>
                <div>
                    <h3>Call Us</h3>
                    <p>+27 11 000 0000</p>
                </div>
            </div>

            <div class="contact-item">
                <i class="fa-solid fa-clock"></i>
                <div>
                    <h3>Working Hours</h3>
                    <p>Monday - Friday: 08:00 - 17:00</p>
                </div>
            </div>

            <div class="contact-socials">
                <h3>Follow RaceDay</h3>

                <a href="https://www.facebook.com/" aria-label="Facebook">
                    <i class="fa-brands fa-facebook"></i>
                </a>

                <a href="https://www.instagram.com/" aria-label="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                </a>

                <a href="https://www.linkedin.com/" aria-label="LinkedIn">
                    <i class="fa-brands fa-linkedin"></i>
                </a>
            </div>

        </div>


        <!-- Contact Form -->
        <div class="contact-form">

            <h2>Send Us a Message</h2>

            <p>Complete the form below and we will get back to you.</p>

            <form method="post" action="#">

                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text"
                           id="name"
                           name="name"
                           placeholder="Enter your full name"
                           required />
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email"
                           id="email"
                           name="email"
                           placeholder="Enter your email address"
                           required />
                </div>

                <div class="form-group">
                    <label for="subject">Subject</label>
                    <input type="text"
                           id="subject"
                           name="subject"
                           placeholder="What is your enquiry about?"
                           required />
                </div>

                <div class="form-group">
                    <label for="message">Your Message</label>
                    <textarea id="message"
                              name="message"
                              rows="5"
                              placeholder="Write your message here..."
                              required></textarea>
                </div>

                <button type="submit" class="contact-submit">
                    Send Message
                    <i class="fa-solid fa-paper-plane"></i>
                </button>

            </form>

        </div>

    </section>


    <!-- Bottom Section -->
    <section class="contact-bottom">

        <i class="fa-solid fa-flag-checkered"></i>

        <h2>Every Race Starts With a Step!</h2>

        <p>
            Thank you for being part of the RaceDay community.
            We look forward to helping you make your next event memorable.
        </p>

        <a href="@Url.Action("Events", "Home")" class="contact-btn">
            Explore Events
        </a>

    </section>

</div>
