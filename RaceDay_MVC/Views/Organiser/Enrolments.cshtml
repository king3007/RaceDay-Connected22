@model List<RaceDay_MVC.Models.EnrolmentDto>
@{ ViewData["Title"] = "Event enrolments"; }
<div class="dashboard-header"><div><p class="eyebrow">YOUR EVENT ENTRIES</p><h1>Enrolments &amp; results.</h1></div><a asp-action="OrganiserDashboard">Back to overview →</a></div><section class="dashboard-container"><div class="data-table"><table><thead><tr><th>Entry</th><th>Participant</th><th>Category</th><th>Status</th><th>Capture result</th></tr></thead><tbody>@foreach(var e in Model) { <tr><td>#@e.UniqueId</td><td>@e.ParticipantName</td><td>@e.CategoryName</td><td>@e.Status</td><td>@if(e.Status != "Completed") { <form asp-action="CaptureResult" asp-route-id="@ViewBag.EventId" method="post" class="result-form"><input type="hidden" name="EnrolmentId" value="@e.UniqueId" /><label>Finish time <input name="FinishTime" placeholder="hh:mm:ss" pattern="[0-9]{2,}:[0-5][0-9]:[0-5][0-9]" required /></label><label>Position <input name="FinishingPosition" type="number" min="1" required /></label><button class="pill-button" type="submit">Save</button></form> } else { <span>Result recorded</span> }</td></tr> }</tbody></table>@if(!Model.Any()) { <p class="empty-state">No participants have enrolled yet.</p> }</div></section>
