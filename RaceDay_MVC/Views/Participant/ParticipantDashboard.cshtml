@model RaceDay_MVC.Models.ParticipantDashboardModel
@{ ViewData["Title"] = "Participant overview"; }
<div class="dashboard-header"><div><p class="eyebrow">YOUR RACEDAY JOURNEY</p><h1>Keep moving, <span>@User.Identity?.Name.</span></h1><p>Your events and results, together in one place.</p></div><a asp-action="BrowseEvents" class="pill-button">Find an event ↗</a></div><section class="dashboard-container"><div class="dashboard-stats"><div class="stat-card"><div class="stat-info"><h2>@Model.Enrolments.Count</h2><p>Enrolments</p></div></div><div class="stat-card"><div class="stat-info"><h2>@Model.Results.Count</h2><p>Results</p></div></div><div class="stat-card"><div class="stat-info"><h2>@Model.Enrolments.Count(e=>e.EventDate >= DateTime.Now)</h2><p>Upcoming entries</p></div></div></div><h2>Your upcoming entries</h2><div class="calendar-agenda">@foreach(var e in Model.Enrolments.Where(e=>e.EventDate >= DateTime.Now).OrderBy(e=>e.EventDate)) { <div class="agenda-row"><span class="agenda-date">@e.EventDate.ToString("dd")<small>@e.EventDate.ToString("MMM")</small></span><div><h2>@e.EventName</h2><p>@e.CategoryName · @e.Status</p></div></div> }@if(!Model.Enrolments.Any(e=>e.EventDate >= DateTime.Now)) { <div class="empty-state"><p>No upcoming entries. Find your next race to get started.</p></div> }</div><div class="card-actions"><a asp-action="MyEnrolments">My enrolments →</a><a asp-action="MyResults">My results →</a><a asp-action="Profile">My profile →</a></div></section>
